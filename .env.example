MODE=SIGNAL
LIVE_CONFIRMED=false
BINGX_API_KEY=
BINGX_API_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Estrategia (valores del Pine original)
RSI_LEN=10
SIG_LEN=10
TRIGGER_LEVEL=50
TARGET_CROSS=2
ST_PERIOD=10
ST_FACTOR=2.5
REQUIRE_ST_BULL=true
SL_SWING_ATR=0.5
SL_SWING_LOOKBACK=20
USE_TP=false
RR_TARGET=2.0

# Universo
TIMEFRAME=15m
SCAN_INTERVAL_SEC=90
MAX_SYMBOLS=400
EXCLUDE_PREFIXES=NC
SYMBOL_WHITELIST=
MIN_QUOTE_VOLUME_24H=3000000
MIN_ATR_PCT=0.5
MAX_RISK_PCT=4.0
COST_ROUNDTRIP_PCT=0.25
MAX_COST_IN_R=0.20
MIN_RISK_PCT=1.5
SCAN_CONCURRENCY=8

# Riesgo
RISK_PCT=0.25
MAX_CONCURRENT=2
LEVERAGE=2
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=180
ENTRY_TYPE=LIMIT
LIMIT_OFFSET_PCT=0.05

# Avisos
SIGNAL_COOLDOWN_MIN=60
DAILY_SUMMARY=true
DAILY_SUMMARY_HOUR_UTC=7
HEARTBEAT_HOURS=12
IDLE_ALERT_DAYS=5

STATE_PATH=/data/state_rsi.json
LOG_LEVEL=INFO
