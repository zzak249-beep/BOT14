# ═══════════════════════════════════════════
# FibStruct Bot v2 — Variables de entorno
# ═══════════════════════════════════════════

# ── BingX API ──────────────────────────────
BINGX_API_KEY=TU_API_KEY
BINGX_SECRET_KEY=TU_SECRET_KEY

# ── Telegram ───────────────────────────────
TELEGRAM_TOKEN=123456789:AAxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxx

# ── Modo ───────────────────────────────────
DRY_RUN=true          # true=paper / false=LIVE

# ── Estrategia ─────────────────────────────
TIMEFRAME=1h
SWING_LEN=10
COOLDOWN_BARS=5
MIN_CONFLUENCE=0.0
ATR_FILTER=true
ATR_MULT=0.5
CONFLUENCE_TOL=0.3
STRICT_ENGULF=true
VOLUME_CONFIRM=false  # true=requiere vol > EMA20
CANDLES_LIMIT=200

# ── Risk ───────────────────────────────────
SL_METHOD=STRUCTURE   # ATR | STRUCTURE
TP_METHOD=FIB_TARGET  # ATR | FIB_TARGET | FIB_HALF
SL_ATR_MULT=1.5
TP_ATR_MULT=2.5
RISK_PCT=1.0
MAX_POSITIONS=3
LEVERAGE=5
MARGIN_TYPE=ISOLATED
MIN_RR=1.5            # R:R mínimo para ejecutar
MAX_POSITION_PCT=20.0 # máx % balance por trade
MAX_ENTRY_ATR_DIST=1.5 # máx ATR entre señal y precio actual

# ── Protección ─────────────────────────────
DAILY_LOSS_LIMIT_PCT=5.0   # % max pérdida diaria
REENTRY_COOLDOWN_BARS=20   # barras antes de re-entrar mismo par

# ── Scanner ────────────────────────────────
MIN_VOLUME_USDT=5000000
MAX_SYMBOLS=80
SCAN_INTERVAL=60
FETCH_WORKERS=10      # threads paralelos fetch
REQUEST_DELAY=0.15

# ── Dirección ──────────────────────────────
LONG_ENABLED=true
SHORT_ENABLED=true

# ── Misc ───────────────────────────────────
LOG_LEVEL=INFO
SUMMARY_HOUR=0        # hora UTC resumen diario (0=medianoche)
HEALTH_PORT=8080
BLACKLIST=             # pares extra a excluir (comma-separated)
