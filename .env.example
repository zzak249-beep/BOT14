# ── Credenciales BingX (API Management -> crear API Key con permiso de Futuros) ──
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_BASE_URL=https://open-api.bingx.com
BINGX_RECV_WINDOW_MS=5000

# True = usa saldo de práctica VST de BingX en vez de USDT real (experimental,
# ver README). Recomendado dejarlo en False y usar LIVE_TRADING=False para
# probar primero sin arriesgar ni requerir VST.
DEMO_MODE=False

# ── Telegram (crea un bot con @BotFather y consigue tu chat_id con @userinfobot) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Interruptor maestro ──────────────────────────────────────────────
# False = el bot calcula señales y las manda por Telegram, pero NUNCA
# manda órdenes reales a BingX. Recomendado para la primera puesta en marcha.
LIVE_TRADING=True

# ── Universo de símbolos ─────────────────────────────────────────────
# "ALL" = todos los perpetuos USDT-M activos en BingX, o lista separada
# por comas: BTC-USDT,ETH-USDT,SOL-USDT
SYMBOLS=ALL
TIMEFRAME=5m

POLL_INTERVAL_SECONDS=30
SYMBOL_BATCH_SIZE=5
SYMBOL_BATCH_DELAY_SECONDS=1.0

# ── Parámetros Wavelet (idénticos a los inputs del script Pine) ──────
LOOKBACK_ENERGY=40
K_DOMINANCE=1.5
COOLDOWN_BARS=4

USE_VOL_FILTER=False
VOL_LEN=20
VOL_MULT=1.2

# ── Riesgo ────────────────────────────────────────────────────────────
QTY_PCT=10.0
LEVERAGE=10

USE_ATR_SL=True
ATR_LENGTH=14
ATR_MULT_SL=1.5
ATR_MULT_TP=2.5
SL_PERCENT=1.0
TP_PERCENT=2.0

# ── Salvaguardas propias del bot (no existen en el script Pine original) ──
MAX_CONCURRENT_POSITIONS=5
SKIP_IF_SYMBOL_HAS_POSITION=True
MIN_BALANCE_USDT=0

LOG_LEVEL=INFO
