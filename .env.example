# ═══════════════════════════════════════════════════════════════
#  QF Machine × JP Fusion Bot — Variables de Entorno
#  Copia esto en Railway → Variables (o en un archivo .env local)
# ═══════════════════════════════════════════════════════════════

# ── BingX API ─────────────────────────────────────────────────
BINGX_API_KEY=tu_api_key_aqui
BINGX_SECRET=tu_secret_aqui

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# ── Modo de operación ─────────────────────────────────────────
# CRÍTICO: "true" = paper trading (sin dinero real)
#           "false" = LIVE (dinero real — solo cuando hayas validado)
PAPER_MODE=true

# ── Ajuste fino ───────────────────────────────────────────────
# Convicción mínima para abrir posición (0-10)
# 6 = conservador, 8 = muy selectivo, 4 = más operaciones
MIN_CONVICTION=6

# Segundos entre cada scan del mercado (mínimo 20)
LOOP_SECONDS=30

# ATR multiplier para trailing stop
TRAIL_ATR=1.5
