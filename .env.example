# ═══════════════════════════════════════════════════════
#  GUA-USDT Bot v2 — Variables Railway
#  Copia exactamente estas variables en Railway
# ═══════════════════════════════════════════════════════

# ── OBLIGATORIAS ───────────────────────────────────────
BINGX_API_KEY=tu_api_key_aqui
BINGX_SECRET=tu_secret_aqui
TELEGRAM_TOKEN=123456789:ABCDEfghijk...
TELEGRAM_CHAT_ID=-100123456789

# ── MODO ── CAMBIA AQUÍ PARA ACTIVAR TRADES REALES ─────
MODE=LIVE

# ── FILTROS DESACTIVADOS (GUA opera 24h) ───────────────
SESSION_FILTER=false
OB_IMBALANCE_THR=0.60

# ── SEÑAL ──────────────────────────────────────────────
SCORE_THR=0.55

# ── CAPITAL ────────────────────────────────────────────
LEVERAGE=5
RISK_PCT=0.02

# ── ATR ────────────────────────────────────────────────
ATR_SL_MULT=1.5
ATR_TP1_MULT=2.0
ATR_TP2_MULT=4.0
ATR_TRAIL_MULT=1.0
ATR_HIGHVOL_MULT=2.0

# ── SÍMBOLO ────────────────────────────────────────────
SYMBOL=GUA-USDT
INTERVAL=3m
INTERVAL_TREND=15m
INTERVAL_MACRO=1h

# ── RAILWAY ────────────────────────────────────────────
PORT=8080
