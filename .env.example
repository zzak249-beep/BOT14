# QF×JP Bot v6.0 — variables de entorno
# Copia este archivo como .env y rellena los valores reales

# ── OBLIGATORIO ───────────────────────────────────────────
BINGX_API_KEY=tu_api_key_aqui
BINGX_SECRET=tu_secret_aqui
TG_TOKEN=tu_telegram_bot_token
TG_CHAT_ID=tu_chat_id

# ── MODO ─────────────────────────────────────────────────
# LIVE = opera real | SIGNAL = solo señales por Telegram
MODE=LIVE

# ── SÍMBOLOS ─────────────────────────────────────────────
SYMBOLS_MODE=AUTO
MIN_VOLUME_USDT=50000000
MAX_VOLUME_USDT=600000000
MAX_SYMBOLS=20

# ── RIESGO ───────────────────────────────────────────────
LEVERAGE=5
RISK_PCT=0.5
MAX_DD_PCT=5.0
MAX_POSITIONS=5
TP_RR=2.0

# ── SESIONES ─────────────────────────────────────────────
SESSIONS=NY,LDN

# ── TIMING ───────────────────────────────────────────────
LOOP_INTERVAL=30
SCANNER_INTERVAL=3600

# ── SEÑAL (composite Score+CVD+Mom+Decay) ────────────────
ENTRY_MIN_COMPOSITE=0.58
SCORE_THR_LONG=0.60
SCORE_THR_SHORT=0.60
DECAY_THR=0.60

# ── CONVICCIÓN MÍNIMA ─────────────────────────────────────
MIN_CONV_STD=5
MIN_CONV_FUEL=6
MIN_CONV_SUP=7

# ── PERFORMANCE FILTER ───────────────────────────────────
MIN_PF=1.2
PF_WINDOW=20

# ── OFI ──────────────────────────────────────────────────
OFI_LEVELS=5
OFI_THR_WEAK=0.25
OFI_THR_STRONG=0.45

# ── FUNDING RATE ─────────────────────────────────────────
FR_BULL_THR=0.0001
FR_BEAR_THR=-0.0001
FR_EXTREME_THR=0.005

# ── OPEN INTEREST ────────────────────────────────────────
OI_DELTA_THR=0.005

# ── TRAILING SL ──────────────────────────────────────────
TRAIL_ACTIVATE_ATR=1.0
TRAIL_ATR_MULT=1.5

# ── ÓRDENES MAKER ────────────────────────────────────────
USE_MAKER_ORDERS=true
MAKER_TIMEOUT=20
MAKER_OFFSET_PCT=0.015

# ── MULTI-TF ─────────────────────────────────────────────
USE_1H_FILTER=true
MULTI_TF_BONUS=2

# ── ANTI-RATE-LIMIT ──────────────────────────────────────
BALANCE_CACHE_TTL=60
API_RETRY_MAX=3
API_RETRY_DELAY=2.0
