# Copy this file to .env for local runs. On Railway, set these as Variables
# in the service settings instead - do not commit a real .env file.

# ===================== BingX API =====================
BINGX_API_KEY=your_bingx_api_key_here
BINGX_API_SECRET=your_bingx_api_secret_here
BINGX_BASE_URL=https://open-api.bingx.com

# ===================== Market =====================
# Comma-separated for multiple symbols, e.g. BTC-USDT,ETH-USDT
SYMBOLS=BTC-USDT
# 15m or 30m - back-test both in TradingView's Strategy Tester on the
# updated Pine script before picking; 30m tends to filter more noise at
# the cost of fewer, later signals. See README section 7.
TIMEFRAME=15m

# ===================== RSI =====================
RSI_LENGTH=10
RSI_TRIGGER_LEVEL=50

# ===================== Doble suelo (v2 - price structure + divergence) =====================
PIVOT_LEFT_BARS=5
PIVOT_RIGHT_BARS=5
MAX_BOTTOM_DIFF_PCT=2.0
MIN_BARS_BETWEEN_LOWS=3
MAX_BARS_BETWEEN_LOWS=50
MIN_NECKLINE_BOUNCE_PCT=1.0
REQUIRE_RSI_DIVERGENCE=true
MAX_WAIT_BARS=20

# ===================== SuperTrend (salida) =====================
SUPERTREND_ATR_PERIOD=10
SUPERTREND_FACTOR=2.5

# ===================== Filtro de tendencia superior (opcional) =====================
# No compra si la EMA de una temporalidad mayor está cayendo fuerte -
# mismo patrón de confirmación multi-timeframe de tus otros bots.
USE_HTF_TREND_FILTER=true
HTF_TIMEFRAME=4h
HTF_EMA_LENGTH=100
HTF_EMA_SLOPE_LOOKBACK=10
HTF_MAX_DOWN_SLOPE_PCT=0.5

# ===================== Riesgo / tamaño de posición =====================
LEVERAGE=5
MARGIN_MODE=ISOLATED

# RISK_PERCENT sizes each trade as RISK_PERCENT_EQUITY% of account equity
# (times leverage); FIXED_MARGIN always uses FIXED_MARGIN_USDT as margin.
POSITION_SIZING_MODE=RISK_PERCENT
RISK_PERCENT_EQUITY=2
FIXED_MARGIN_USDT=50

# Optional hard stop, placed as a real reduceOnly order on BingX (not just
# checked locally). 0 disables it. e.g. 3 = close 3% below entry price.
STOP_LOSS_PCT=0

# Decimal places BingX expects for this symbol's quantity/price - check the
# contract spec for your symbol before going live, the defaults are generic.
QUANTITY_PRECISION=3
PRICE_PRECISION=2

# ===================== Runtime =====================
POLL_INTERVAL_SECONDS=30
KLINES_LOOKBACK=500
RECV_WINDOW_MS=5000

# true = compute and notify signals only, never send real orders.
DRY_RUN=true

STATE_FILE_PATH=./data/state.json
LOG_LEVEL=INFO

# ===================== Telegram =====================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
