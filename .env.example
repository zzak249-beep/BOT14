# ═══════════════════════════════════════════
#  QF×JP Bot v3.0 — Variables de Entorno
#  Copia este archivo como .env y rellena
# ═══════════════════════════════════════════

# ── BingX API ──────────────────────────────
BINGX_API_KEY=tu_api_key_aqui
BINGX_SECRET=tu_secret_aqui

# ── Telegram ───────────────────────────────
TG_TOKEN=123456789:ABCdef...
TG_CHAT_ID=-100123456789

# ── Modo: SIGNAL (solo alertas) o LIVE ─────
MODE=SIGNAL

# ── Símbolos (separados por coma) ──────────
SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT

# ── Riesgo ─────────────────────────────────
LEVERAGE=10
RISK_PCT=1.0
MAX_DD_PCT=5.0
TP_RR=2.0

# ── Convicción mínima por tier ─────────────
MIN_CONV_STD=5
MIN_CONV_FUEL=7
MIN_CONV_SUP=8

# ── Sesiones activas: NY, LDN, ASIA ────────
SESSIONS=NY,LDN

# ── Intervalo de loop (segundos) ───────────
LOOP_INTERVAL=30
