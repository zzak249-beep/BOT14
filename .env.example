# ── Build (Railway/Railpack) ──
# Railway ya no usa Nixpacks por defecto (deprecado/legacy) -- el
# builder actual es Railpack. La variable de version correcta es
# RAILPACK_PYTHON_VERSION, no NIXPACKS_PYTHON_VERSION.
RAILPACK_PYTHON_VERSION=3.13

# ── Credenciales BingX ──
# Usa una API key de SUBCUENTA dedicada a ESTE bot. Nunca compartas la
# misma cuenta/API key entre varios bots: interferencia cruzada garantizada.
BINGX_API_KEY=
BINGX_API_SECRET=
BINGX_BASE_URL=https://open-api.bingx.com

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Modo ──
# SIGNAL = solo escanea y notifica, no coloca ordenes. EMPIEZA AQUI.
# LIVE   = coloca ordenes reales.
MODE=SIGNAL

# HEDGE o ONEWAY. Consulta tu cuenta: app BingX > Futuros > Preferencias > Modo de posicion.
POSITION_MODE=HEDGE

# ── Universo de simbolos ──
QUOTE_ASSET=USDT
# Simbolos separados por coma, cualquier formato (BTC-USDT, BTCUSDT, btc/usdt)
SYMBOL_BLACKLIST=
SYMBOL_WHITELIST=
MIN_24H_VOLUME_USDT=0
SYMBOL_REFRESH_MIN=60

# ── Timeframes ──
TIMEFRAME=5m
HTF_TIMEFRAME=1h
USE_HTF_BIAS=true
HTF_EMA_LEN=50

# ── Kill zones (hora de Nueva York) ──
USE_KILL_ZONES=true
KZ_LONDON=true
KZ_NY_AM=true
KZ_NY_PM=false
KZ_ASIA=false
KZ_ONLY_ENTRY=false
REFERENCE_RANGE=0000-0830

# ── Calidad del setup ──
MIN_GAP_ATR=0.25
DISPLACEMENT_ATR=0.80
ENTRY_MODE=CONFIRMATION
CE_EXPIRY_BARS=12
FVG_EXPIRY_BARS=30
SWEEP_EXPIRY_BARS=20
USE_EQ=true
SWEEP_MIN_WICK_PCT=0

# ── Deteccion de sweep intra-vela ──
# false (por defecto) = espera a que la vela cierre, igual que siempre.
# true = detecta el sweep contra la vela AUN en formacion (provisional,
# se revalida al cierre real). Solo afecta al sweep, no a la FVG.
INTRA_CANDLE_SWEEP=false

# ── Lead-lag entre simbolos ──
# BTC suele barrer un nivel antes que los alts correlacionados. Puramente
# informativo (viaja en Telegram como lead_confirmed) -- no filtra nada.
USE_LEAD_LAG=false
LEAD_SYMBOL=BTC-USDT
LEAD_LAG_WINDOW_MIN=15
EQ_PIVOT_LEN=15
EQ_TOL_ATR=0.10
USE_PREMIUM_DISCOUNT=false
DIRECTION=BOTH

# ── Ruta B: Continuación (CHoCH + retroceso a golden zone) ──
# Complementa la Ruta A (sweep+FVG) de arriba -- dos rutas separadas
# y etiquetadas (REV/CONT), no fusionadas. Si disparan direcciones
# contrarias en el mismo ciclo, se anulan las dos.
USE_PATH_A=true
USE_PATH_B=true
SWING_LEN=10
GZ_LOW=0.5
GZ_HIGH=0.618
CONT_CONFIRM=ENGULF

# ── Funding rate / Open Interest (nuevos, apagados por defecto) ──
# Sin validar en vivo todavia. Prueba con USE_FUNDING_FILTER/USE_OI_FILTER
# en false primero, compara el desglose de resultados, y solo entonces
# actívalos uno a la vez.
USE_FUNDING_FILTER=false
FUNDING_MIN_ABS=0.0001
USE_OI_FILTER=false
OI_MAX_INCREASE_PCT=3.0

# ── Riesgo ──
MIN_RR=1.5
SL_BUFFER_ATR=0.5
RR_FIXED_FALLBACK=2.5
USE_RANGE_TP=true
RISK_PCT=1.0
LEVERAGE=5
USE_PARTIAL_TP=true
PARTIAL_TP_R=1.0
PARTIAL_TP_PCT=50
BE_OFFSET_R=0.05
MAX_TRADES_PER_DAY=8
MAX_CONCURRENT_POSITIONS=5
MAX_BARS_IN_TRADE=0

# ── Escaneo ──
SCAN_INTERVAL_SEC=60
KLINES_LOOKBACK=300
MAX_CONCURRENT_REQUESTS=12

# ── Estado / logs ──
# /data requiere un volumen de Railway montado ahi. Sin volumen, el
# estado se pierde en cada redeploy.
STATE_FILE=/data/state.json
LOG_LEVEL=INFO
