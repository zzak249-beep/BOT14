# ─── BingX API ──────────────────────────────────────────────
BINGX_API_KEY=your_bingx_api_key_here
BINGX_SECRET_KEY=your_bingx_secret_key_here

# ─── Telegram ────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── Candle timeframe ─────────────────────────────────────────
# Options: 1m 3m 5m 15m 30m 1h 2h 4h 6h 1d
INTERVAL=1h

# ─── SAMA Strategy Parameters ─────────────────────────────────
SAMA_LENGTH=200
MAJ_LENGTH=14
MIN_LENGTH=6
SLOPE_PERIOD=34
SLOPE_RANGE=25
FLAT=17

# ─── Scanner Filters ──────────────────────────────────────────
# Top N symbols by 24h volume to scan (BingX has ~300+ pairs)
MAX_SYMBOLS=80
# Minimum 24h volume in USDT (filter low-liquidity pairs)
MIN_VOL=1000000

# ─── Position Management ──────────────────────────────────────
# Maximum concurrent open positions
MAX_POSITIONS=5
LEVERAGE=5
# % of balance allocated per trade (split evenly across max positions)
RISK_PCT=1
TP_PCT=2
SL_PCT=1
MIN_QTY=0.001
QTY_STEP=0.001

# ─── Operational ──────────────────────────────────────────────
# Send market summary every N scans
SUMMARY_EVERY=6
# DRY_RUN=true means NO real orders. Set to false only when ready!
DRY_RUN=true
