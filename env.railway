# ══════════════════════════════════════════
#   QF Machine × JP Fusion Bot v3
#   Variables de entorno — Railway
# ══════════════════════════════════════════

# ── BingX API ─────────────────────────────
BINGX_API_KEY=tu_api_key_aqui
BINGX_SECRET=tu_secret_aqui

# ── Telegram ──────────────────────────────
TELEGRAM_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=tu_chat_id_numerico

# ── Modo de operación ─────────────────────
# "true"  = paper trading (sin dinero real)
# "false" = LIVE (¡solo tras validar en paper!)
PAPER_MODE=true

# ── Parámetros del bot ────────────────────
# Convicción mínima para abrir operación (0-10)
MIN_CONVICTION=6

# Segundos entre cada tick del loop
LOOP_SECONDS=30

# Multiplicador ATR para trailing stop
TRAIL_ATR=1.5
