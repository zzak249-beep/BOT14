# ════════════════════════════════════════════════════════════════
#  QF×JP Bot v6.5 — Variables de entorno para Railway
#  Copia cada línea en Railway → Variables → New Variable
#  SIN los comentarios que rompían el parsing anterior
#
#  ⚠️  AÑADE MANUALMENTE (no están aquí por seguridad):
#       BINGX_API_KEY
#       BINGX_SECRET_KEY
#       TELEGRAM_TOKEN
#       TELEGRAM_CHAT_ID
# ════════════════════════════════════════════════════════════════

# ── Modo ──────────────────────────────────────────────────────
MODE=LIVE

# ── Capital y riesgo ──────────────────────────────────────────
CAPITAL=700
RISK_PCT=0.5
LEVERAGE=10
MAX_OPEN_TRADES=3
MAX_DAILY_TRADES=20

# ── Notional cap (CRÍTICO anti-liquidación) ───────────────────
MAX_NOTIONAL_USDT=200

# ── Daily loss limit ─────────────────────────────────────────
DAILY_LOSS_PCT=2.0

# ── SL / TP (SL_ATR_MULT=2.0 evita stop hunts) ───────────────
SL_ATR_MULT=2.0
TP1_ATR_MULT=1.5
TP2_ATR_MULT=2.5
ATR_LEN=10

# ── Umbrales de señal ─────────────────────────────────────────
MIN_SCORE=55.0
FUEL_SCORE=62.0
SUP_SCORE=78.0
MIN_TIER=FUEL

# ── Entrada ───────────────────────────────────────────────────
REQUIRE_TL_BREAK=true
HTF_MIN_ALIGNED=2

# ── Scanner ───────────────────────────────────────────────────
SCAN_INTERVAL=60
MIN_VOLUME_USDT=5000000
TOP_N_SYMBOLS=0
BLACKLIST=

# ── Kelly sizing ──────────────────────────────────────────────
KELLY_WIN_RATE=0.60
KELLY_RR=1.5
KELLY_FRACTION=0.25

# ── Circuit Breaker ───────────────────────────────────────────
CB_ENABLED=true
CB_ATR_MULT=3.0
CB_BARS=10

# ── Gestión de posiciones ─────────────────────────────────────
BREAKEVEN_ATR_MULT=1.0
POSITION_CHECK_INTERVAL=30

# ── Puerto ────────────────────────────────────────────────────
PORT=8080
